---
interface Props {
  headline: string;
  subheadline: string;
  primaryCta: {
    text: string;
    href: string;
  };
  secondaryCta?: {
    text: string;
    href: string;
  };
  badge?: string;
}

const { headline, subheadline, primaryCta, secondaryCta, badge } = Astro.props;
---

<section class="py-16 md:py-24 lg:py-32">
  <div class="container-narrow text-center">
    {badge && (
      <div class="inline-flex items-center px-3 py-1 mb-6 text-sm font-medium bg-primary-50 text-primary-700 rounded-full">
        {badge}
      </div>
    )}
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 mb-6 text-balance">
      {headline}
    </h1>
    <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
      {subheadline}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={primaryCta.href} class="btn-accent text-base w-full sm:w-auto">
        {primaryCta.text}
      </a>
      {secondaryCta && (
        <a href={secondaryCta.href} class="btn-secondary text-base w-full sm:w-auto">
          {secondaryCta.text}
        </a>
      )}
    </div>
  </div>
</section>
