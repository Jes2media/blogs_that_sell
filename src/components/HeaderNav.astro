---
const navLinks = [
  { href: '/start-here', label: 'Start Here' },
  { href: '/blog', label: 'Blog' },
  { href: '/blogs-that-sell', label: 'Blogs That Sell' },
  { href: '/blog-sales-letter-templates', label: 'Templates' },
  { href: '/get-more-sales', label: 'Get More Sales' },
];

const resourcesDropdown = [
  { href: '/copywriting-legends', label: 'Copywriting Legends' },
  { href: '/marketing-experts', label: 'Marketing Experts' },
  { href: '/copywriting-frameworks', label: 'Copywriting Frameworks' },
  { href: '/email-copywriting-guide', label: 'Email Copywriting' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-100">
  <nav class="container-wide">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center font-bold text-xl text-gray-900 hover:text-primary-600 transition-colors">
        Blogs That Sell
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
              currentPath === link.href
                ? 'bg-primary-50 text-primary-700'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
            ]}
          >
            {link.label}
          </a>
        ))}

        <!-- Resources Dropdown -->
        <div class="relative" id="resources-dropdown">
          <button
            type="button"
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-lg transition-colors flex items-center gap-1',
              resourcesDropdown.some(r => currentPath === r.href)
                ? 'bg-primary-50 text-primary-700'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
            ]}
            id="resources-btn"
          >
            Resources
            <svg class="w-4 h-4 transition-transform" id="resources-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="hidden absolute top-full left-0 mt-1 w-48 bg-white rounded-lg shadow-lg border border-gray-100 py-1" id="resources-menu">
            {resourcesDropdown.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'block px-4 py-2 text-sm transition-colors',
                  currentPath === link.href
                    ? 'bg-primary-50 text-primary-700'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
                ]}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>

        <a
          href="/about"
          class:list={[
            'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
            currentPath === '/about'
              ? 'bg-primary-50 text-primary-700'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
          ]}
        >
          About
        </a>
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a href="/free-training" class="btn-accent text-sm">
          Get free training
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="lg:hidden p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-50 rounded-lg"
        aria-label="Open menu"
        id="mobile-menu-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div class="hidden lg:hidden pb-4" id="mobile-menu">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 text-base font-medium rounded-lg transition-colors min-h-[48px] flex items-center',
              currentPath === link.href
                ? 'bg-primary-50 text-primary-700'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
            ]}
          >
            {link.label}
          </a>
        ))}

        <!-- Mobile Resources Section -->
        <div class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wider mt-2">
          Resources
        </div>
        {resourcesDropdown.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 pl-6 text-base font-medium rounded-lg transition-colors min-h-[48px] flex items-center',
              currentPath === link.href
                ? 'bg-primary-50 text-primary-700'
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
            ]}
          >
            {link.label}
          </a>
        ))}

        <a
          href="/about"
          class:list={[
            'px-4 py-3 text-base font-medium rounded-lg transition-colors min-h-[48px] flex items-center mt-2',
            currentPath === '/about'
              ? 'bg-primary-50 text-primary-700'
              : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
          ]}
        >
          About
        </a>

        <a href="/free-training" class="btn-accent text-base mt-2 text-center min-h-[48px] flex items-center justify-center">
          Get free training
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Desktop Resources dropdown
  const resourcesBtn = document.getElementById('resources-btn');
  const resourcesMenu = document.getElementById('resources-menu');
  const resourcesChevron = document.getElementById('resources-chevron');
  const resourcesDropdown = document.getElementById('resources-dropdown');

  resourcesBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    resourcesMenu?.classList.toggle('hidden');
    resourcesChevron?.classList.toggle('rotate-180');
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!resourcesDropdown?.contains(e.target as Node)) {
      resourcesMenu?.classList.add('hidden');
      resourcesChevron?.classList.remove('rotate-180');
    }
  });

  // Close dropdown on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      resourcesMenu?.classList.add('hidden');
      resourcesChevron?.classList.remove('rotate-180');
    }
  });
</script>
