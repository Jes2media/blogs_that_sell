---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  maxPosts?: number;
}

const { currentPost, maxPosts = 3 } = Astro.props;

// Get all published posts except the current one
const allPosts = await getCollection('blog', ({ data, id }) => {
  return data.draft !== true && id !== currentPost.id;
});

// Score posts by tag overlap
const scoredPosts = allPosts.map((post) => {
  const currentTags = new Set(currentPost.data.tags);
  const matchingTags = post.data.tags.filter((tag) => currentTags.has(tag));
  return {
    post,
    score: matchingTags.length,
    matchingTags,
  };
});

// Sort by score (most matching tags first), then by date
const relatedPosts = scoredPosts
  .filter((item) => item.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
  })
  .slice(0, maxPosts)
  .map((item) => item.post);

// If not enough related posts by tags, fill with recent posts
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((post) => !relatedPosts.includes(post))
  .slice(0, maxPosts - relatedPosts.length);

const postsToShow = [...relatedPosts, ...recentPosts].slice(0, maxPosts);
---

{postsToShow.length > 0 && (
  <section class="mt-16 pt-10 border-t border-gray-200">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">
      Continue Reading
    </h2>
    <div class="grid gap-6 md:grid-cols-3">
      {postsToShow.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group block p-5 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors"
        >
          <time
            datetime={post.data.pubDate.toISOString()}
            class="text-xs text-gray-500"
          >
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })}
          </time>
          <h3 class="mt-2 font-semibold text-gray-900 group-hover:text-primary-600 transition-colors line-clamp-2">
            {post.data.title}
          </h3>
          <p class="mt-2 text-sm text-gray-600 line-clamp-2">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-3">
              {post.data.tags.slice(0, 2).map((tag) => (
                <span class="px-2 py-0.5 bg-gray-200 text-gray-600 text-xs rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a
        href="/blog"
        class="inline-flex items-center text-primary-600 hover:text-primary-800 font-medium"
      >
        View all articles
        <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>
)}
