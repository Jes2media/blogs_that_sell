---
interface Props {
  headline?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  headline = 'Get the free direct-response blog framework used by 6-figure freelancers.',
  ctaText = 'Get It Free',
  ctaHref = '/free-training',
} = Astro.props;
---

<div class="bg-primary-900 text-white">
  <div class="container-wide py-3">
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-center sm:text-left">
      <p class="text-sm md:text-base font-medium">
        {headline}
      </p>
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent-dark text-white font-semibold text-sm rounded-lg transition-colors whitespace-nowrap"
      >
        {ctaText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
