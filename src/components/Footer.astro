---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms' },
  { href: '/contact', label: 'Contact' },
  { href: '/sitemap-index.xml', label: 'Sitemap' },
];

const socialLinks = [
  { href: '#', label: 'X (Twitter)', icon: 'x' },
  { href: '#', label: 'YouTube', icon: 'youtube' },
  { href: '#', label: 'LinkedIn', icon: 'linkedin' },
];
---

<footer class="bg-gray-50 border-t border-gray-200">
  <div class="container-wide py-12 md:py-16">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="font-bold text-xl text-gray-900">
          Blogs That Sell
        </a>
        <p class="mt-3 text-gray-600 max-w-md">
          A direct-response system for freelancers, consultants, and marketers who want blog traffic that actually converts into sales.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/start-here" class="text-gray-600 hover:text-primary-600 transition-colors">Start Here</a></li>
          <li><a href="/blog" class="text-gray-600 hover:text-primary-600 transition-colors">Blog</a></li>
          <li><a href="/get-more-sales" class="text-gray-600 hover:text-primary-600 transition-colors">Get More Sales</a></li>
          <li><a href="/free-training" class="text-gray-600 hover:text-primary-600 transition-colors">Free Training</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4">Connect</h3>
        <div class="flex gap-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-200 text-gray-600 hover:bg-primary-600 hover:text-white transition-colors"
              aria-label={link.label}
            >
              {link.icon === 'x' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {link.icon === 'youtube' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="text-sm text-gray-600">
          &copy; {currentYear} Blogs That Sell. All rights reserved.
        </p>
        <nav class="flex flex-wrap gap-4">
          {footerLinks.map((link) => (
            <a href={link.href} class="text-sm text-gray-600 hover:text-primary-600 transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</footer>
