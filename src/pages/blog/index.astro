---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OptInRibbon from '../../components/OptInRibbon.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Articles on writing blog posts that rank and convert. Direct-response copywriting meets SEO content strategy."
>
  <OptInRibbon />

  <section class="py-12 md:py-16 lg:py-20">
    <div class="container-wide">
      <header class="max-w-2xl mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 mb-4">
          Blog
        </h1>
        <p class="text-lg text-gray-600">
          Practical strategies for writing blog content that ranks on Google and converts readers into customers.
        </p>
      </header>

      {posts.length === 0 ? (
        <div class="text-center py-16 bg-gray-50 rounded-xl">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Coming Soon</h2>
          <p class="text-gray-600 mb-6">
            We're working on in-depth articles. Sign up to be notified when new posts go live.
          </p>
          <a href="/free-training" class="btn-primary">
            Get Free Training Instead
          </a>
        </div>
      ) : (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.id}`} class="block">
                {post.data.hero && (
                  <div class="aspect-video mb-4 overflow-hidden rounded-lg bg-gray-100">
                    <img
                      src={post.data.hero}
                      alt={post.data.heroAlt || post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="space-y-2">
                  <h2 class="text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors">
                    {post.data.title}
                  </h2>
                  <p class="text-gray-600 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="flex flex-wrap gap-2 pt-2">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <CTASection
    headline="Want the Complete System?"
    subheadline="Get the free training that shows you how to write blog posts that rank AND convert."
    primaryCta={{ text: 'Get Free Training', href: '/free-training' }}
    variant="accent"
  />
</BaseLayout>
