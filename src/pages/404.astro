---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Let's get you back on track."
  noindex={true}
>
  <section class="py-20 md:py-32">
    <div class="container-narrow text-center">
      <div class="text-8xl font-bold text-gray-200 mb-8">404</div>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Page Not Found
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-lg mx-auto">
        The page you're looking for doesn't exist or has been moved. But don't worry—let's get you back on track.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/" class="btn-primary">
          Go Home
        </a>
        <a href="/start-here" class="btn-secondary">
          Start Here
        </a>
      </div>

      <div class="border-t border-gray-200 pt-12">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">
          Popular Pages
        </h2>
        <div class="grid sm:grid-cols-2 gap-4 max-w-md mx-auto text-left">
          <a href="/blog-that-sells" class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <div class="font-medium text-gray-900">Blog That Sells</div>
            <div class="text-sm text-gray-600">The core philosophy</div>
          </a>
          <a href="/blog-sales-letter-templates" class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <div class="font-medium text-gray-900">Templates</div>
            <div class="text-sm text-gray-600">Plug-and-play frameworks</div>
          </a>
          <a href="/the-system" class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <div class="font-medium text-gray-900">The System</div>
            <div class="text-sm text-gray-600">Complete training</div>
          </a>
          <a href="/free-training" class="p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
            <div class="font-medium text-gray-900">Free Training</div>
            <div class="text-sm text-gray-600">Get started free</div>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
